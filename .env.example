# ---- Required (12) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
DATABASE_URL=
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Comma-separated Telegram user IDs allowed to run /admin only
TELEGRAM_ALLOWED_USER_IDS=
# Public origin, e.g. https://your-app.vercel.app
APP_URL=https://bot-xsync-delta.vercel.app

# ---- Supabase Storage (used by the ZIP upload path) ----
SUPABASE_URL=
# Server-only secret key. Never sent to the browser.
SUPABASE_SECRET_KEY=
# Private bucket, e.g. github-uploads
SUPABASE_STORAGE_BUCKET=github-uploads

# ---- Optional ----
# PEM CA certificate for Supabase Postgres TLS, only if the default trust store rejects it. Newlines may be \n.
DATABASE_CA_CERT=
# Bearer secret for /api/cron/cleanup (at least 16 characters)
CRON_SECRET=

# ---- GitHub Actions processor (replaces the always-on worker) ----
# Fine-grained PAT limited to THIS repository with only "Actions: Read and write". Lets Vercel trigger the
# processor right after an upload. Optional: without it, the scheduled sweep (every ~30 min) processes jobs.
ACTIONS_DISPATCH_TOKEN=
# Repository that holds .github/workflows/process-uploads.yml and the branch to run it on
WORKER_REPO=kenza11-star/Bot-gitele
WORKER_REF=main
